{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sanad Design Tokens",
  "color": {
    "light": {
      "paper-50": "#FAF6EC",
      "paper-100": "#F3EDDD",
      "paper-200": "#E7DFC9",
      "ink-900": "#15191F",
      "ink-700": "#3A424D",
      "ink-500": "#66707C",
      "neel": "#1F2F5C",
      "sindoor": "#C2412D",
      "haldi": "#D8A238",
      "verified": "#1E6B4A",
      "caution": "#9A5B00",
      "danger": "#B3261E",
      "neutral": "#5B6572"
    },
    "dark": {
      "night-950": "#0F1318",
      "night-900": "#161B22",
      "night-800": "#1F2630",
      "night-border": "#2B3440",
      "paper-text": "#ECE7DA",
      "ink-muted": "#AEB6C2",
      "neel-lit": "#8FA6E8",
      "sindoor-lit": "#E8674F",
      "verified-lit": "#62C08D",
      "caution-lit": "#E6B35A",
      "danger-lit": "#F08A80"
    }
  },
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-6": "24px",
    "space-8": "32px",
    "space-12": "48px",
    "space-16": "64px",
    "space-24": "96px",
    "space-36": "144px"
  },
  "typography": {
    "font-serif": "Fraunces, Georgia, 'Times New Roman', serif",
    "font-sans": "'Public Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "font-hindi": "'Noto Sans Devanagari', sans-serif",
    "font-hindi-heading": "'Noto Serif Devanagari', serif",
    "font-mono": "'IBM Plex Mono', Menlo, Consolas, monospace",
    "scale": {
      "display": "clamp(2.75rem, 5vw, 5rem)",
      "h1": "clamp(2rem, 3.5vw, 3rem)",
      "h2": "1.75rem",
      "h3": "1.375rem",
      "body": "1rem",
      "small": "0.875rem",
      "caption": "0.8125rem"
    }
  },
  "radii": {
    "card": "6px",
    "input": "6px",
    "button": "6px",
    "seal": "50%"
  },
  "motion": {
    "dur-instant": "80ms",
    "dur-fast": "160ms",
    "dur-base": "240ms",
    "dur-slow": "400ms",
    "dur-seal": "1000ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-enter": "cubic-bezier(0, 0, 0, 1)",
    "ease-exit": "cubic-bezier(0.3, 0, 1, 1)"
  }
}
