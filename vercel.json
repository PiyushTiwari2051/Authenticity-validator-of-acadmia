{
  "version": 2,
  "builds": [
    {
      "src": "standalone_server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/css/(.*)",   "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)",    "dest": "/frontend/js/$1" },
    { "src": "/api/(.*)",   "dest": "/standalone_server.js" },
    { "src": "/(index\\.html)?$", "dest": "/frontend/index.html" }
  ]
}
