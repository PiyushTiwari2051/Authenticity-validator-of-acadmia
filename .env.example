# Environment configuration template for Sanad Platform
# Copy to .env for local overrides (never commit .env)

SANAD_ENV=development
SANAD_CANONICAL_HOST=localhost

# Database (PostgreSQL)
SANAD_DATABASE_URL=postgresql+asyncpg://sanad_app:sanad_secret_pw@postgres:5432/sanad_db

# Cache and Queue (Redis)
SANAD_REDIS_URL=redis://redis:6379/0

# Storage (MinIO S3)
SANAD_S3_ENDPOINT=http://minio:9000
SANAD_S3_ACCESS_KEY=sanad_minio_admin
SANAD_S3_SECRET_KEY=sanad_minio_secure_pw
SANAD_S3_BUCKET=sanad-documents

# Security and Crypto
SANAD_JWT_SECRET=dev_jwt_secret_change_in_production_32bytes_min
SANAD_KEK=dev_kek_32bytes_aes_gcm_must_be_set_in_env_securely!

# Platform Anchoring
SANAD_ENABLE_EVM_ANCHOR=false
SANAD_EVM_RPC_URL=
SANAD_EVM_CONTRACT_ADDRESS=
SANAD_EVM_PRIVATE_KEY=
